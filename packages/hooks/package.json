{
  "name": "@saturn/hooks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./finance": {
      "types": "./finance/index.ts",
      "import": "./finance/index.ts",
      "default": "./finance/index.ts"
    },
    "./finance/*": {
      "types": "./finance/*.ts",
      "import": "./finance/*.ts",
      "default": "./finance/*.ts"
    },
    "./timezone": {
      "types": "./timezone/index.ts",
      "import": "./timezone/index.ts",
      "default": "./timezone/index.ts"
    },
    "./i18n": {
      "types": "./i18n/index.ts",
      "import": "./i18n/index.ts",
      "default": "./i18n/index.ts"
    },
    "./connector": {
      "types": "./connector/index.ts",
      "import": "./connector/index.ts",
      "default": "./connector/index.ts"
    },
    "./calendar": {
      "types": "./calendar/index.ts",
      "import": "./calendar/index.ts",
      "default": "./calendar/index.ts"
    },
    "./space": {
      "types": "./space/index.ts",
      "import": "./space/index.ts",
      "default": "./space/index.ts"
    },
    "./ai": {
      "types": "./ai/index.ts",
      "import": "./ai/index.ts",
      "default": "./ai/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@saturn/api": "*",
    "@saturn/core": "*",
    "@saturn/i18n": "*",
    "@saturn/schemas": "*",
    "@tanstack/react-query": "^5.102.8"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^7.0.2"
  }
}
