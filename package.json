{
  "name": "saturn",
  "private": true,
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=saturn-web",
    "dev:mobile": "npm run start --workspace=saturn-mobile",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.11.10"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "uuid": "^11.1.1"
  }
}
